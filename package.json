{
  "name": "tongpin",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "concurrently -k -n server,web 'pnpm --filter @tongpin/server dev' 'pnpm --filter @tongpin/web dev'",
    "build": "pnpm --filter @tongpin/web build && pnpm --filter @tongpin/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "start": "pnpm --filter @tongpin/server start",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "socket.io-client": "^4.8.0",
    "better-sqlite3": "^12.4.0",
    "@types/better-sqlite3": "^7.6.13"
  },
  "version": "0.1.0",
  "license": "MIT"
}
